# Public GA4 web stream measurement ID. Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=

# Local development sends analytics only when explicitly enabled for DebugView.
VITE_GA_DEBUG=false

# Server-side only (Vercel project env, no VITE_ prefix). HTTPS endpoint that receives
# surgeon page leads as JSON; without it /api/lead answers 503 and the popup shows an error.
LEAD_WEBHOOK_URL=
