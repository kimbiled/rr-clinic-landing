# Public GA4 web stream measurement ID. Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=

# Local development sends analytics only when explicitly enabled for DebugView.
VITE_GA_DEBUG=false

# Server-side only (Vercel project env, no VITE_ prefix). Bitrix24 incoming webhook with the CRM
# permission, e.g. https://<portal>.bitrix24.kz/rest/<user id>/<secret>/. Surgeon page leads become
# CRM leads; without it /api/lead answers 503 and the popup shows an error. Never commit the real value.
BITRIX_WEBHOOK_URL=
