# RR Clinic on shared Apache + PHP hosting (ps.kz). `npm run build:hosting` copies this folder into dist/.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

# Bundles are ES modules: browsers refuse to run them without a JavaScript type.
AddType text/javascript .mjs
AddType image/webp .webp
AddType font/woff2 .woff2
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.rr-clinic\.kz$ [NC]
  RewriteRule ^ https://rr-clinic.kz%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^rr-clinic\.kz$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://rr-clinic.kz%{REQUEST_URI} [R=301,L]
  RewriteRule ^api/lead$ api/lead.php [L]
  # Rustam's page is now ours (React, /doctors/<slug>/); the old Framer copy's address points there.
  RewriteRule ^kurmanbayev-rustam/?$ /doctors/kurmanbayev-rustam/ [R=301,L]
  # Алина Улагашева is no longer with the clinic (2026-11-05): her old pages lead to the surgeons list.
  RewriteRule ^ulagasheva-alina(/.*)?$ /doctors/ [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
