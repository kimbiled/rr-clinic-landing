{
  "name": "rr-clinic-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/analytics-bundle.mjs && tsc -b && vite build",
    "build:hosting": "npm run build && cp -R hosting/. dist/ && rm -f dist/README.md && rm -rf dist/.ruff_cache && rm -f rr-clinic-hosting.zip && (cd dist && zip -qr ../rr-clinic-hosting.zip .)",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "sync:framer-bundles": "node scripts/framer-bundles.mjs",
    "test:analytics": "node --test tests/analytics.test.mjs",
    "test:surgeon-pages": "node --test tests/surgeon-pages.test.mjs",
    "build:analytics": "node scripts/analytics-bundle.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "antd": "^6.6.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
